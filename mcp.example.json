{
  "mcp_servers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./storage"
      ],
      "env": {}
    },
    "slack": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "YOUR_SLACK_BOT_TOKEN_HERE",
        "SLACK_TEAM_ID": "YOUR_SLACK_TEAM_ID_HERE",
        "SLACK_CHANNEL_IDS": "YOUR_SLACK_CHANNEL_IDS_HERE"
      }
    }
  },
  "allowed_tools": [
    "mcp__calendar__*",
    "mcp__filesystem__*",
    "mcp__slack__*"
  ]
}
